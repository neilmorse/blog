---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, href } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.flatMap(p => p.data.tags))].map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(p => p.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`# ${tag}`}><section class="page-intro"><a class="back-link" href={href('tags/')}>← 所有话题</a><div class="eyebrow">A BRANCH OF THE GARDEN</div><h1># {tag}</h1><p>这个话题下，种下了 {posts.length} 篇文章。</p></section><div class="narrow">{posts.map(post => <PostCard post={post}/>)}</div></BaseLayout>
