---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime, tagHref, href, postHref } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { id: post.id }, props: { post, next: posts[i + 1] } }));
}
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={post.data.title} description={post.data.description} article date={post.data.date}>
  <header class="article-header"><a class="back-link" href={href('archives/')}>← 全部文章</a><div class="post-tags">{post.data.tags.map(tag => <a href={tagHref(tag)}># {tag}</a>)}</div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="post-meta"><span>Neil</span><span>·</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>·</span><span>{readingTime(post.body)} 分钟阅读</span></div></header>
  <div class="article-grid"><article class="prose"><Content /><div class="article-end">✳<p>感谢阅读，愿这些记录对你有所帮助。</p><a href={href('rss.xml')}>订阅下一次生长 →</a></div>{next && <a class="next-post" href={postHref(next)}><span>继续阅读</span><strong>{next.data.title} →</strong></a>}</article>{toc.length > 0 && <aside class="toc"><nav aria-label="文章目录"><span class="eyebrow">这篇文章</span>{toc.map(h => <a class:list={{ subheading: h.depth === 3 }} href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}</div>
</BaseLayout>
